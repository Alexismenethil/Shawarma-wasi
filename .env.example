# ─── Desarrollo ───────────────────────────────────────────────────────────
# Base de datos (docker compose levanta Postgres en el 5434)
DATABASE_URL="postgresql://wasi:wasi@localhost:5434/shawarma_wasi"

# Puerto de la API (en producción el hosting suele ponerlo solo)
PORT=4310
# Firma de las sesiones del personal: una cadena larga y aleatoria.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="cambia-esto-por-una-cadena-larga"
# Orígenes que pueden llamar a la API desde otro dominio (separados por coma).
# Solo hace falta en desarrollo (Vite en el 5190) o si la web se publica aparte.
ORIGEN_WEB="http://localhost:5190"

# PIN inicial de cada área (solo los usa `npm run db:seed` la primera vez).
# Después el equipo se arma en Administración → Equipo.
SEED_PIN_MOZO="1111"
SEED_PIN_COCINA="2222"
SEED_PIN_ADMIN="9090"

# ─── Producción (un solo servidor: web + API + tiempo real) ───────────────
# NODE_ENV=production hace que la API sirva también la web compilada.
# NODE_ENV="production"
# Con Neon, usa la cadena de conexión DIRECTA (sin "-pooler") y sslmode=require:
# DATABASE_URL="postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Solo si la web se publica en otro dominio que la API (no es lo recomendado):
# VITE_API_EXTERNA="https://api.tu-dominio.com"
