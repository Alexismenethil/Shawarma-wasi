# ─── Desarrollo ───────────────────────────────────────────────────────────
# Base de datos (docker compose levanta Postgres en el 5434)
DATABASE_URL="postgresql://wasi:wasi@localhost:5434/shawarma_wasi"

# Puerto de la API (en producción el hosting suele ponerlo solo)
PORT=4310
# Firma de las sesiones del personal: una cadena larga y aleatoria (en producción,
# al menos 32 caracteres; con la de ejemplo el servidor no arranca).
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="cambia-esto-por-una-cadena-larga"
# Orígenes que pueden llamar a la API desde otro dominio (separados por coma).
# Solo hace falta en desarrollo (Vite en el 5190) o si la web se publica aparte.
ORIGEN_WEB="http://localhost:5190"
# Cuántos proxies hay delante del servidor: 1 en Render, Railway o Fly (el valor
# por defecto); 0 si el servidor es una PC del local sin proxy.
# PROXIES=1

# Acceso inicial (solo los usa `npm run db:seed` la primera vez; después el
# personal se arma en Administración → Equipo). Mozo, cocina y caja de la
# primera sucursal entran con estos PIN de 4 cifras, distintos entre sí; las
# demás sucursales reciben otros al azar (ningún PIN se repite entre sucursales).
# La administración entra con usuario y contraseña (mínimo 8 caracteres; luego
# se cambia en «Cambiar mi contraseña»).
SEED_PIN_MOZO="1111"
SEED_PIN_COCINA="2222"
SEED_PIN_CAJA="3333"
SEED_ADMIN_USUARIO="admin"
SEED_ADMIN_CLAVE="cambia-esta-clave"

# ─── Vercel Hobby + Neon Free (ver DESPLIEGUE.md) ────────────────────────
# NODE_ENV="production"
# SINCRONIZACION="consulta"
# DB_CONEXIONES=2
# API: conexión pooled, sin opciones de sesión. Conserva el SSL de Neon.
# DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Migraciones: conexión directa a la misma base y rama.
# DIRECT_URL="postgresql://usuario:clave@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
# CRON_SECRET="otro-secreto-aleatorio-de-al-menos-32-caracteres"
# No configurar VITE_API_EXTERNA en Vercel: web y API usan el mismo dominio.

# Servidor tradicional separado del frontend, solo si se necesita:
# VITE_API_EXTERNA="https://api.tu-dominio.com"
